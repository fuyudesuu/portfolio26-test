# Copy to .env.local for local dev; set the same names in Vercel for deploys.
# Never commit real values.

# Admin login username
ADMIN_USERNAME=

# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
ADMIN_PASSWORD_HASH=

# HMAC key for session cookies. >= 32 chars, must differ from ADMIN_PASSWORD_HASH.
#   openssl rand -base64 32
SESSION_SECRET=

# Fine-grained PAT: this repo only, Contents read/write only.
GITHUB_TOKEN=

# Target repo as owner/name
GITHUB_REPO=

# Branch content is committed to (optional, defaults to main)
GITHUB_BRANCH=
